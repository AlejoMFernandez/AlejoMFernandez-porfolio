{
  "cleanUrls": true,
  "redirects": [
    { "source": "/en", "destination": "/?lang=en", "permanent": true },
    { "source": "/en/:path*", "destination": "/?lang=en", "permanent": true },
    { "source": "/pt-br", "destination": "/?lang=pt", "permanent": true },
    { "source": "/pt-br/:path*", "destination": "/?lang=pt", "permanent": true }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
