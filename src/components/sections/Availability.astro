---
interface Cta { label: string; href: string }
interface Props {
  heading: string;
  body: string;
  cta?: Cta;
}
const { heading, body, cta } = Astro.props;
const external = (href: string) => href.startsWith('http');
---

<section id="availability" class="section availability">
  <div class="container availability__inner">
    <span class="availability__dot" aria-hidden="true"></span>
    <div>
      <h2>{heading}</h2>
      <p>{body}</p>
      {cta && (
        <a href={cta.href} class="btn btn--ghost availability__cta" target={external(cta.href) ? '_blank' : undefined} rel="noopener">
          {cta.label}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .availability {
    border-top: 1px solid var(--border-color);
  }
  .availability__inner {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    max-width: 720px;
  }
  .availability__dot {
    flex: none;
    margin-top: 0.75rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 6px color-mix(in srgb, #22c55e 20%, transparent);
  }
  .availability h2 {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
  }
  .availability p {
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }
  .availability__cta {
    margin-top: 1.75rem;
  }
</style>
