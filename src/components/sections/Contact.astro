---
interface Cta { label: string; href: string }
interface Props {
  heading: string;
  lead?: string;
  ctaPrimary: Cta;
}
const { heading, lead, ctaPrimary } = Astro.props;
const external = (href: string) => href.startsWith('http');
---

<section id="contacto" class="section contact">
  <div class="container contact__inner">
    <h2 class="contact__title">{heading}</h2>
    {lead && <p class="contact__lead">{lead}</p>}
    <div class="contact__actions">
      <a
        href={ctaPrimary.href}
        class="btn btn--primary"
        target={external(ctaPrimary.href) ? '_blank' : undefined}
        rel="noopener"
      >
        {ctaPrimary.label}
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--border-color);
    background: var(--bg-secondary);
    text-align: center;
  }
  .contact__inner {
    max-width: 700px;
  }
  .contact__title {
    font-size: clamp(2.25rem, 7vw, 4.25rem);
    line-height: 1.02;
  }
  .contact__lead {
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: var(--text-secondary);
  }
  .contact__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }
</style>
