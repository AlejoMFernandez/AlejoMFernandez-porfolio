---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import type { Locale } from '../../i18n/utils';

interface Props {
  heading: string;
  subtitle?: string;
  locale: Locale;
}
const { heading, subtitle, locale } = Astro.props;

// Same set of projects for every locale — only the framing/copy differs.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// CreativeWork schema per visible project.
const creativeWorks = projects.map((p) => {
  const copy = locale === 'en' ? p.data.en : p.data.es;
  return {
    '@type': 'CreativeWork',
    name: p.data.name,
    description: copy.summary,
    ...(p.data.url ? { url: p.data.url } : {}),
    keywords: p.data.tech.join(', '),
    inLanguage: locale,
    creator: { '@id': `${Astro.site}#person` },
  };
});
const jsonLd = { '@context': 'https://schema.org', '@graph': creativeWorks };
---

<section id={locale === 'en' ? 'work' : 'casos'} class="section projects">
  <div class="container">
    <header class="projects__head">
      <h2>{heading}</h2>
      {subtitle && <p>{subtitle}</p>}
    </header>

    <div class="projects__grid">
      {projects.map((p) => <ProjectCard project={p.data} locale={locale} />)}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .projects__head {
    max-width: 640px;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .projects__head h2 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .projects__head p {
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }
  @media (max-width: 400px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
