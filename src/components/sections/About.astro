---
import { Picture } from 'astro:assets';
import profile from '../../assets/images/profilephoto.webp';

interface Cta { label: string; href: string }
interface Props {
  eyebrow?: string;
  heading: string;
  body: string[];
  cta?: Cta;
}
const { eyebrow, heading, body, cta } = Astro.props;
---

<section id="sobre-mi" class="section about">
  <div class="container about__inner">
    <div class="about__photo">
      <Picture
        src={profile}
        formats={['avif', 'webp']}
        widths={[320, 640, 900]}
        sizes="(max-width: 760px) 80vw, 40vw"
        alt="Alejo Fernández"
        loading="lazy"
      />
    </div>

    <div class="about__text">
      {eyebrow && <span class="about__eyebrow">{eyebrow}</span>}
      <h2>{heading}</h2>
      {body.map((p) => <p>{p}</p>)}
      {cta && (
        <a href={cta.href} target={cta.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="about__cta">
          {cta.label}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .about {
    border-top: 1px solid var(--border-color);
  }
  .about__inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 4.5rem);
  }
  .about__photo {
    aspect-ratio: 4 / 5;
  }
  .about__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
    border: 1px solid var(--border-color);
  }
  .about__eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: 1rem;
  }
  .about__text h2 {
    font-size: clamp(1.75rem, 4vw, 2.6rem);
    max-width: 16ch;
  }
  .about__text p {
    margin-top: 1.25rem;
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 52ch;
  }
  .about__cta {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 600;
    color: var(--text-primary);
    border-bottom: 2px solid var(--accent-color);
    padding-bottom: 2px;
    transition: opacity 0.18s var(--ease-out);
  }
  .about__cta:hover {
    opacity: 0.7;
  }
  @media (max-width: 760px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .about__photo {
      max-width: 320px;
    }
  }
</style>
