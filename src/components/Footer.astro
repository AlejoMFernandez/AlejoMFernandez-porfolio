---
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const socials = [
  { label: 'GitHub', href: 'https://github.com/AlejoMFernandez' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/alejo-fernandez-87b387254' },
  { label: 'Instagram', href: 'https://www.instagram.com/alejomf.dev' },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__copy">© {year} Alejo Fernández. {t('footer.rights')}</p>
    <div class="footer__socials">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-color);
    padding-block: 2.5rem;
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .footer__copy {
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }
  .footer__socials {
    display: flex;
    gap: 1.5rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .footer__socials a {
    color: var(--text-secondary);
    transition: color 0.18s var(--ease-out);
  }
  .footer__socials a:hover {
    color: var(--text-primary);
  }
</style>
