---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { getAlternates, getCanonical, getPagePath, type Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogLocale: string; // es_AR | en_US
  ogImage: string; // root-relative, e.g. /images/og-es.jpg
}

const { locale, title, description, ogLocale, ogImage } = Astro.props;
const t = useTranslations(locale);

const pagePath = getPagePath(Astro.url.pathname);
const canonical = getCanonical(locale, pagePath);
const alternates = getAlternates(pagePath);
const ogImageAbs = new URL(ogImage, Astro.site).href;

// ── Structured data ─────────────────────────────────────────────────────────
// ProfessionalService: areaServed is GLOBAL (not a city). availableLanguage es+en.
// Person: founder, with knowsLanguage + knowsAbout.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${Astro.site}#service`,
      name: 'Alejo Fernández — Web Development',
      url: canonical,
      description,
      areaServed: { '@type': 'GeoShape', name: 'Worldwide' },
      availableLanguage: ['es', 'en'],
      founder: { '@id': `${Astro.site}#person` },
      provider: { '@id': `${Astro.site}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${Astro.site}#person`,
      name: 'Alejo Martín Fernández',
      url: Astro.site,
      jobTitle: locale === 'en' ? 'Front-end Developer' : 'Desarrollador Web',
      knowsLanguage: ['es', 'en'],
      knowsAbout: ['React', 'Vue', 'Astro', 'TypeScript', 'Front-end Performance', 'Web SEO'],
      sameAs: [
        'https://github.com/AlejoMFernandez',
        'https://www.linkedin.com/in/alejo-fernandez-87b387254',
      ],
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logoAFwhiteCUADRADO.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/logoAFblackCUADRADO.png" media="(prefers-color-scheme: light)" />
    <link rel="apple-touch-icon" href="/logoAFwhiteCUADRADO.png" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- hreflang (published locales + x-default) -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Alejo Fernández" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Self-hosted Manrope (preload hero weight) -->
    <Font cssVariable="--font-manrope" preload />

    <!-- Theme color -->
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header locale={locale} pagePath={pagePath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <GoogleAnalytics />
  </body>
</html>
